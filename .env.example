# ==============================================================================
# NetScope Environment Configuration
# ==============================================================================

# Default network capture interface (Leave empty for automatic host discovery)
NETSCOPE_DEFAULT_INTERFACE=

# Packet buffer capacity in memory (default: 5000 packets)
NETSCOPE_MAX_PACKET_BUFFER=5000

# Capture mode: live or simulated
NETSCOPE_MODE=live

# Authentication
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3003
CLIENT_ORIGIN=http://127.0.0.1:3003,http://localhost:3003
COOKIE_SECURE=false

# SMTP (Gmail: smtp.gmail.com, port 587, use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-address@gmail.com
